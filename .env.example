# Frontend public configuration (safe to expose in the browser).
# Vite variables prefixed with VITE_ are bundled into client code.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/sales-chatbot-api

# Server-side Supabase Edge Function secrets — configure in Supabase Dashboard > Edge Functions > Secrets.
# NEVER add SUPABASE_SERVICE_ROLE_KEY or GEMINI_API_KEY to VITE_ variables.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# GEMINI_API_KEY=YOUR_SERVER_ONLY_GEMINI_API_KEY
